# --- Database (Postgres) ---
# Workspaces, roles/bindings, doc metadata, and the full-text search index.
DATABASE_URL="postgres://user:password@host:port/db-name"

# Set when DATABASE_URL points at pgbouncer in transaction mode: it turns off
# named prepared statements, which a pooler cannot keep across statements.
# In docker compose the app gets this automatically; migrations never do, because
# drizzle-kit needs a direct connection for DDL and advisory locks.
# PGBOUNCER=true
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT=30
# DATABASE_CONNECT_TIMEOUT=10

# --- Deployment (docker compose) ---
# Images published to GHCR by .github/workflows/ci.yml.
# TABULA_IMAGE=ghcr.io/leonardomb1/tabula
# TABULA_TAG=latest               # or a git sha / v1.2.3 tag to pin a release
# TABULA_TOOLS_IMAGE=ghcr.io/leonardomb1/tabula-tools   # migration image
# TABULA_PULL_POLICY=always       # `missing` to use a locally built image / offline

# Public hostname Caddy serves and requests a Let's Encrypt certificate for. The
# HTTP-01 challenge needs this name to resolve publicly to the host, with ports 80
# and 443 reachable. If the name is internal-only, HTTP-01 cannot validate: use the
# DNS-01 challenge instead, which needs a Caddy image built with your DNS provider
# module (xcaddy build --with github.com/caddy-dns/<provider>).
SITE_ADDRESS=docs.example.com
ACME_EMAIL=admin@example.com
# Use the staging directory while testing so a misconfiguration does not burn the
# production rate limit for this name:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
#
# Must match the scheme and host the browser uses, or form posts are rejected.
ORIGIN=https://docs.example.com
# HTTP_PORT=80
# HTTPS_PORT=443
# POSTGRES_USER=tabula
# POSTGRES_PASSWORD=              # change this before deploying
# POSTGRES_DB=tabula
# POSTGRES_HOST_PORT=5433
# MINIO_ROOT_USER=tabula
# MINIO_ROOT_PASSWORD=            # change this before deploying
# MINIO_CONSOLE_PORT=9001
# BODY_SIZE_LIMIT=33554432        # 32 MB, matching Caddy's request_body limit

# --- Typst (PDF export) ---
# Directories searched for fonts. The image installs DejaVu and Liberation; add the
# brand's own by mounting them and extending this path.
# TYPST_FONTS_PATH=/usr/share/fonts
# TYPST_WORKSPACE=/tmp/tabula-typst-root

# --- Auth ---
# Credentials are verified against an internal directory HTTP route (k-auth),
# which returns AD group memberships used for workspace bindings. This is the only
# auth source for now; OIDC/others slot in behind the same identity shape later.
KAUTH_URL="https://directory.example.com/api/r/k-auth"
KAUTH_TOKEN=              # bearer token the route requires
SESSION_SECRET=          # HMAC key for signing session cookies (openssl rand -hex 32)
SESSION_HOURS=8          # session lifetime; also the cookie maxAge
PLATFORM_ADMIN_GROUPS="DOCS_PLATFORM_ADMINS"   # AD groups granting platform admin (| or , separated)
# PLATFORM_ADMIN_USERS="jdoe,asilva"           # usernames granted platform admin directly
# COOKIE_SECURE=true     # force Secure cookies; default follows the ORIGIN scheme

# --- Storage ---
# Where document sources, images, attachments, and compiled artifacts live.
# One backend at a time. Keys are backend-agnostic; only the driver differs.
STORAGE=local                     # local | s3 | azure

# local — reads/writes a directory on disk (default backend).
STORAGE_LOCAL_PATH=./content

# s3 — AWS S3 or any S3-compatible store (MinIO, Cloudflare R2, Wasabi, Backblaze).
# docker compose sets these for the bundled MinIO; the values below are for
# running the app outside compose against it.
# S3_BUCKET=tabula
# S3_REGION=us-east-1             # 'auto' for R2; a real region for AWS
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=tabula
# S3_SECRET_ACCESS_KEY=tabula-secret
# S3_FORCE_PATH_STYLE=true        # required by MinIO; defaults true when S3_ENDPOINT is set
# S3_PREFIX=                      # optional: namespace a shared bucket, e.g. tabula/

# azure — Azure Blob Storage, or ADLS Gen2 accounts via the Blob endpoint.
# AZURE_STORAGE_CONTAINER=docs
# Auth: either a connection string...
# AZURE_STORAGE_CONNECTION_STRING=
# ...or an account name + key:
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_ENDPOINT=         # optional override; defaults to https://<account>.blob.core.windows.net
# AZURE_STORAGE_PREFIX=           # optional: namespace a shared container

# --- Wiki ---
# The public wiki at /wiki serving approved published docs. off hides it, org
# requires sign-in, anonymous serves it to the internet (crawlable via robots.txt).
# WIKI_MODE=org                   # off | org | anonymous

# --- Branding ---
# The organisation this instance belongs to — shown in the logo slot. The platform
# itself is always called Tabula, so these never rename the product.
# BRAND_NAME="Acme"                # wordmark beside/instead of the logo; default "Tabula"
# BRAND_COLOR="#2563eb"            # any CSS color; drives the whole accent palette
# BRAND_COMPANY="Acme Inc."        # company line (PDF cover footer); defaults to BRAND_NAME
# Logo served by SvelteKit from content/branding/logo.svg (upload it) or an external
# URL. Empty string disables and falls back to the text wordmark.
# BRAND_LOGO_URL=/api/branding/logo.svg
# BRAND_LOGO_NEGATIVE_URL=/api/branding/logo_negative.svg   # inverted, for dark theme
