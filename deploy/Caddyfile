# Reverse proxy, load balancer and TLS terminator in front of the app instances.
#
# Caddy obtains and renews the certificate from Let's Encrypt itself, keeping the
# account key and certificates in the caddy-data volume. It also redirects HTTP to
# HTTPS automatically, so no redirect block is needed here.
#
# Requirements for the HTTP-01 challenge to succeed:
#   - SITE_ADDRESS resolves publicly to this host
#   - ports 80 and 443 reach this container from the internet
# If the name is internal-only, HTTP-01 cannot validate and you need the DNS-01
# challenge instead, which requires a Caddy build that includes your DNS provider
# module. See the note in .env.example.
#
# Set ACME_CA to the staging directory while testing, so a misconfiguration does
# not burn Let's Encrypt's rate limit for the real name.
{
	admin off
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	request_body {
		max_size 32MB
	}

	header {
		# Only honest once TLS is actually serving, which it is by the time a
		# response carries this header.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Vite content-hashes these filenames, so they can be cached indefinitely.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	log {
		output stdout
		format console
	}

	reverse_proxy app1:3000 app2:3000 {
		# Sessions are stateless signed cookies, so any instance can serve any
		# request and no sticky-session policy is needed.
		lb_policy least_conn
		lb_try_duration 5s
		lb_try_interval 250ms

		# Shallow on purpose: it reports whether the instance is up, not whether
		# Postgres is. A database blip should degrade the service, not empty the
		# pool and take it down entirely.
		health_uri /healthz
		health_interval 10s
		health_timeout 3s
		health_status 2xx
	}
	# X-Forwarded-For / -Proto / -Host are set by reverse_proxy already; the app
	# reads them via ADDRESS_HEADER / PROTOCOL_HEADER / HOST_HEADER.
}
