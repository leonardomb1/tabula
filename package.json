{
	"name": "refactor",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun ./build/index.js",
		"messages": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations",
		"prepare": "bun run messages && svelte-kit sync || echo \"\"",
		"check": "bun run messages && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test src",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run scripts/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"db:push:force": "drizzle-kit push --force",
		"db:migrate:status": "bun run scripts/migrate.ts status"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.18.2",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7",
		"@types/bun": "^1.3.14",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.5"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3",
		"@azure/storage-blob": "^12",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.10.4",
		"@codemirror/lang-markdown": "^6.5.1",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.1",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.7",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/hanken-grotesk": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/literata": "^5.3.0",
		"@fontsource-variable/lora": "^5.3.0",
		"@fontsource-variable/merriweather": "^5.3.0",
		"@fontsource-variable/noto-sans": "^5.3.0",
		"@fontsource-variable/open-sans": "^5.3.0",
		"@fontsource-variable/roboto": "^5.3.0",
		"@fontsource-variable/source-sans-3": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"@fontsource/atkinson-hyperlegible": "^5.3.0",
		"@fontsource/lato": "^5.3.0",
		"@lezer/highlight": "^1.2.3",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@myriaddreamin/typst-ts-node-compiler": "0.7.0",
		"@myriaddreamin/typst-ts-renderer": "0.7.0",
		"@myriaddreamin/typst-ts-web-compiler": "0.7.0",
		"@myriaddreamin/typst.ts": "0.7.0",
		"@shikijs/markdown-it": "^4.3.1",
		"codemirror-lang-typst": "^0.4.0",
		"drizzle-orm": "^0.45.2",
		"gray-matter": "^4.0.3",
		"ldapts": "^9.0.0",
		"markdown-it": "^14.3.0",
		"postgres": "^3.4.9",
		"shiki": "^4.3.1",
		"zod": "^3"
	}
}
